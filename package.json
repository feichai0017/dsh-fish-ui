{
  "name": "dsh-fish-ui",
  "version": "0.2.1",
  "type": "module",
  "description": "Deep Fish UI — a dot-matrix theme for DeepSeek Harness: fish hero artwork, whale-blue accents, reading layout, Maple Mono NF CN type, composer glow and fish-finish toggles.",
  "license": "MIT",
  "author": "Guocheng Song",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feichai0017/dsh-fish-ui.git"
  },
  "homepage": "https://github.com/feichai0017/dsh-fish-ui#readme",
  "bugs": {
    "url": "https://github.com/feichai0017/dsh-fish-ui/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0",
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "dot-matrix",
    "fish",
    "maple-mono",
    "font"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  }
}
