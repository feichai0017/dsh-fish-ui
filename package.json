{
  "name": "dsh-fish-ui",
  "version": "0.10.0-preview.7",
  "type": "module",
  "description": "The original whale-girl dot portrait, scene-aware glass and motion, and native approval navigation for DeepSeek Harness.",
  "license": "MIT",
  "author": "Guocheng Song",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feichai0017/dsh-fish-ui.git"
  },
  "homepage": "https://github.com/feichai0017/dsh-fish-ui#readme",
  "bugs": {
    "url": "https://github.com/feichai0017/dsh-fish-ui/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "icon.png",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0",
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "dot-matrix",
    "fish",
    "maple-mono",
    "font"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "build": "npm run check && esbuild src/index.ts --bundle --platform=node --packages=external --format=esm --target=node22 --outfile=dist/index.js && esbuild src/client.ts --bundle --format=iife --target=es2022 --loader:.svg=dataurl --loader:.webp=dataurl --loader:.jpg=dataurl --loader:.png=dataurl --outfile=dist/client.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  }
}
